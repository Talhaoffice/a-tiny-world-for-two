# Copy to .env.local and fill these values from Firebase Console > Project settings.
# These are public Firebase web-app identifiers, not privileged server credentials.
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=your-web-app-id
# Set this at build time when building the production frontend for Render's
# combat API. Local emulator development may leave it unset to use emulators.
# VITE_COMBAT_API_URL=https://your-combat-service.onrender.com
# Development defaults to the local emulators. Set to "hosted" only when you
# intentionally want a development server to use the configured hosted project.
VITE_FIREBASE_TARGET=emulator
