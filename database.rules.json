{
  "rules": {
    ".read": false,
    ".write": false,
    "members": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "world": {
      "players": {
        ".read": "auth != null && root.child('members').child(auth.uid).val() === true",
        "$uid": {
          "appearance": {
            ".write": "auth != null && auth.uid === $uid && root.child('members').child(auth.uid).val() === true && newData.exists()",
            ".validate": "newData.hasChildren(['hair', 'outfit', 'accessory'])",
            "hair": { ".validate": "newData.val() === 'short' || newData.val() === 'long'" },
            "outfit": { ".validate": "newData.val() === 'jacket' || newData.val() === 'cardigan' || newData.val() === 'dress'" },
            "accessory": { ".validate": "newData.val() === 'none' || newData.val() === 'lantern-clip' || newData.val() === 'sage-accent'" },
            "$other": { ".validate": false }
          },
          "emote": {
            ".write": "auth != null && auth.uid === $uid && root.child('members').child(auth.uid).val() === true && newData.exists()",
            ".validate": "newData.hasChildren(['kind', 'sentAt']) && (!data.exists() || newData.child('sentAt').val() >= data.child('sentAt').val() + 2500) && newData.child('sentAt').val() >= now - 7000 && newData.child('sentAt').val() <= now + 1000",
            "kind": { ".validate": "newData.val() === 'wave' || newData.val() === 'heart' || newData.val() === 'sparkle' || newData.val() === 'hug' || newData.val() === 'sit-bench' || newData.val() === 'sit-blanket' || newData.val() === 'pond-lantern-on' || newData.val() === 'pond-lantern-off' || newData.val() === 'mood-off' || newData.val() === 'mood-gold' || newData.val() === 'mood-rose' || newData.val() === 'mood-sage'" },
            "sentAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          },
          "presence": {
            ".write": "auth != null && auth.uid === $uid && root.child('members').child(auth.uid).val() === true",
            ".validate": "newData.hasChildren(['online', 'lastChanged'])",
            "online": { ".validate": "newData.isBoolean()" },
            "lastChanged": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          },
          "position": {
            ".write": "auth != null && auth.uid === $uid && root.child('members').child(auth.uid).val() === true",
            ".validate": "newData.hasChildren(['x', 'y', 'updatedAt'])",
            "x": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1536" },
            "y": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1024" },
            "updatedAt": { ".validate": "newData.isNumber()" },
            "zone": { ".validate": "newData.val() === 'island' || newData.val() === 'home'" },
            "anim": { ".validate": "newData.val() === 'idle' || newData.val() === 'walk' || newData.val() === 'wave' || newData.val() === 'sit' || newData.val() === 'sleep'" },
            "$other": { ".validate": false }
          },
          "$other": { ".write": false, ".validate": false }
        }
      }
    }
  }
}
