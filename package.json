{
  "name": "a-tiny-world-for-two",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test:security": "firebase emulators:exec --only firestore,database --project a-tiny-world-for-two \"node --test tests/firestore.rules.test.js\"",
    "test:unit": "node --experimental-strip-types --test tests/letter-schedule.test.js tests/errors-logger.test.js tests/character-animation.test.js tests/intro-flow.test.js tests/world-atmosphere.test.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "phaser": "^4.2.1",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "latest",
    "firebase-tools": "^15.34.1",
    "typescript": "latest",
    "vite": "latest"
  }
}
